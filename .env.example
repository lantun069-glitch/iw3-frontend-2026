# Copiar a .env.local (ya excluido por .gitignore) y ajustar segun el
# entorno. Ningun valor de este archivo es real ni secreto.

# URL base del backend cuando NO se usa el proxy de desarrollo de Vite
# (por ejemplo, para apuntar a la VM una vez que este configurada).
# Vacio/sin definir = rutas relativas ("/api/v1/..."), resueltas por
# el proxy local durante `npm run dev` (ver VITE_API_PROXY_TARGET).
VITE_API_BASE_URL=

# Backend al que el proxy de desarrollo de Vite reenvia las rutas
# /api/* durante `npm run dev`. Default si se omite: http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:8080
